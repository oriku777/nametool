# WordPressサイトのURL（末尾にスラッシュは不要）
WP_URL=https://meiseikobetsu.jp

# WordPressのユーザー名（ログインID or メールアドレス）
WP_USERNAME=your-username

# ユーザープロフィール画面の「アプリケーションパスワード」で発行した値
# 例: abcd 1234 efgh 5678 ijkl 9012 （スペースはそのままでも詰めてもどちらでも可）
# ※ `post` コマンド（REST API版）で使用します
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 通常のログインパスワード
# ※ `post-browser` コマンド（ブラウザ自動操作版）でのみ使用します。
#   REST API版（post コマンド）しか使わない場合は設定不要です。
WP_PASSWORD=your-login-password
